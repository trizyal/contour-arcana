{
  "name": "contour-arcana",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm:dev": "wasm-pack build contour --dev --target web --out-dir ../src/pkg",
    "wasm:build": "wasm-pack build contour --release --target web --out-dir ../src/pkg",
    "watch:wasm": "cargo-watch -C contour -w src -s \"wasm-pack build --dev --target web --out-dir ../src/pkg\"",
    "dev": "npm run wasm:dev && concurrently -k \"npm:watch:wasm\" \"vite\"",
    "build": "npm run wasm:build && tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
